{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "start-site": "bash scripts/start-site.sh",
    "build": "cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:fyp": "yarn test:fyp:unit && yarn test:fyp:e2e",
    "test:fyp:unit": "vitest run --passWithNoTests fyp first-year",
    "test:fyp:e2e": "playwright test fyp",
    "test:hub:e2e": "playwright test hub",
    "update-fyp-guides": "node scripts/update-fyp-guides.mjs",
    "emails:preview": "tsx --env-file=.env.local scripts/send-preview-emails.mts",
    "ftp-legacy-transition:test": "tsx scripts/send-ftp-legacy-transition.mts test",
    "ftp-legacy-transition:prod": "tsx scripts/send-ftp-legacy-transition.mts prod",
    "season-group-dates:test": "tsx scripts/populate-season-group-dates.mts test",
    "season-group-dates:prod": "tsx scripts/populate-season-group-dates.mts prod",
    "prepare": "husky"
  },
  "dependencies": {
    "@beehiiv/sdk": "^0.1.6",
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "15.1.4",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.4",
    "lucide-react": "^1.52.0",
    "next": "15.5.24",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "resend": "^6.32.1",
    "stripe": "^22.1.1",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.0.1",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.1.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.1.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
